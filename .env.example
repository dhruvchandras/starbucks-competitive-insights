# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
# If omitted, the agent will gracefully fall back to the built-in strategic heuristic engine
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Slack or Discord incoming webhook URL to receive daily morning dispatches
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Optional: Bearer token to protect the Vercel Cron endpoint (/api/cron/scan)
CRON_SECRET=your_random_secure_cron_secret_here
